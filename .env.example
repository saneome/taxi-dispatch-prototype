# Ключи API (заполненный .env НЕ КОММИТИТСЯ В GIT)
# Скопируйте этот файл в .env и укажите ваши ключи

# 1. Ключ Яндекс JavaScript API v3 (карта, маркеры и линии)
YANDEX_MAPS_API_KEY=

# 2. Ключ API Геокодера (Поиск адресов по координатам со стороны бэкенда)
YANDEX_GEOCODER_API_KEY=

# 3. Токен Mapbox для серверных запросов, без URL restrictions
MAPBOX_ACCESS_TOKEN=
MAPBOX_INTERVAL_MS=250
MAPBOX_DAILY_REQUEST_LIMIT=2500
